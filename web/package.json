{
  "name": "oldcape-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run && vitest run -c worker/vitest.config.ts",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "test:worker": "vitest run -c worker/vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
