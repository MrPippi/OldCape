# Cache rules for Workers static assets.

# The page itself: always revalidate, so a new deploy shows up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Vite output: file names carry a content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cape data: every URL carries ?r=<content hash of public/data> (build/data-rev.ts),
# so a rebuilt index can never meet stale atlas sheets.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# Font subsets: renamed if they ever change.
/fonts/*
  Cache-Control: public, max-age=2592000

# Link-preview image: social sites cache it themselves; a day here is plenty.
/og.png
  Cache-Control: public, max-age=86400
