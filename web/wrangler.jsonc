{
  // Static-only Worker: serves the Vite build output, no server code.
  "name": "oldcape",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "oldcape.org", "custom_domain": true },
    { "pattern": "www.oldcape.org", "custom_domain": true }
  ]
}
